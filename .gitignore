# ═══════════════════════════════════════════════════
# HarisAI — .gitignore
# ═══════════════════════════════════════════════════

# ─── DONNÉES — ne jamais pusher ────────────────────
training/data/
models/
*.csv
*.parquet
*.xlsx
*.json.gz
*.docx
*.txt

# ─── MODÈLES ENTRAÎNÉS ─────────────────────────────
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.bin
*.onnx
*.xgb

# ─── MLFLOW ────────────────────────────────────────
mlruns/
mlartifacts/

# ─── PYTHON ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
pip-wheel-metadata/

# ─── ENVIRONNEMENTS VIRTUELS ───────────────────────
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# ─── JUPYTER ───────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── LOGS ──────────────────────────────────────────
*.log
logs/

# ─── SYSTÈME ───────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── DOCKER ────────────────────────────────────────
.docker/

# ─── TESTS ─────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ─── CE QU'ON GARDE ────────────────────────────────
# training/data_loaders/   → loaders de code
# training/train_xgboost.py → script d'entraînement
# training/data/.gitkeep   → dossier vide maintenu